# ===== المصدر 1: خدمة بحث مجمّعة (أساسي) =====
# سجّل في https://serpapi.com وانسخ مفتاح API من لوحة التحكم
SERPAPI_KEY=
# لغة النتائج: en (موصى بها لدقة المطابقة) أو ar
SERPAPI_HL=en

# ===== المصدر 2: الواجهة الرسمية لأمازون (Creators API) =====
# يحتاج حساب Amazon Associates مفعّل في كل سوق، ومن هناك تطلع بيانات Creators API
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG_AE=
AMAZON_PARTNER_TAG_SA=

# ===== المصدر 3: سحب البيانات =====
# يتفعّل من config/scrapers.json. اكتب هنا إيميل أو موقع للتواصل يظهر للمتاجر
SCRAPER_CONTACT=

# ===== تنبيهات الأسعار =====
# كل كم ساعة نفحص التنبيهات
ALERT_CHECK_HOURS=6
# رابط Webhook يستقبل التنبيهات (من Make أو Zapier أو n8n) ويرسلها واتساب أو تيليجرام أو إيميل
ALERT_WEBHOOK_URL=

# ===== عام =====
PORT=3000
# مدة حفظ نتيجة البحث بالدقائق (توفّر من رصيد SerpApi)
CACHE_MINUTES=30
RATE_LIMIT_PER_MINUTE=30
# سعر الدينار الكويتي بالدرهم (الدينار مربوط بسلة عملات)
KWD_TO_AED=11.95
# MOCK=1 يشغّل بيانات تجريبية حتى لو فيه مفاتيح
MOCK=
